          "datasource": { "type": "postgres", "uid": "ds-timescale" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS critical FROM silver.alerts a JOIN silver.dim_sites s ON s.site_id = a.site_id WHERE s.country = 'IN' AND a.closed_at IS NULL AND a.severity IN ('BREAKAGE_RISK','CRITICAL')"
        }
      ],
      "title": "Critical alerts now",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "ds-timescale" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ds-timescale" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT t.fridge_id) AS active FROM silver.telemetry_raw t JOIN silver.dim_fridges f ON f.fridge_id = t.fridge_id JOIN silver.dim_sites s ON s.site_id = f.site_id WHERE s.country = 'IN' AND t.event_ts > NOW() - INTERVAL '10 minutes'"
        }
      ],
      "title": "Fridges reporting (10m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "ds-timescale" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ds-timescale" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS suspect FROM silver.inventory_lots l JOIN silver.dim_sites s ON s.site_id = l.site_id WHERE s.country = 'IN' AND l.suspect"
        }
      ],
      "title": "Suspect lots",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "ds-timescale" },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ds-timescale" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS at_risk FROM silver.forecasts f JOIN silver.dim_sites s ON s.site_id = f.site_id WHERE s.country = 'IN' AND f.forecast_ts > NOW() - INTERVAL '24 hours' AND f.shortage_prob >= 0.5"
        }
      ],
      "title": "Drugs ≥50% stockout risk",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "ds-timescale" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never" },
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",  "value": null },
              { "color": "green", "value": 2 },
              { "color": "red",   "value": 8 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ds-timescale" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT t.bucket AS time, t.fridge_id AS metric, t.avg_temp_c FROM silver.telemetry_5m t JOIN silver.dim_fridges f ON f.fridge_id = t.fridge_id JOIN silver.dim_sites s ON s.site_id = f.site_id WHERE s.country = 'IN' AND $__timeFilter(t.bucket) AND ('$fridge' = 'all' OR t.fridge_id = '$fridge') ORDER BY t.bucket"
        }
      ],
      "title": "Fridge temperature (5-min avg, °C)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "ds-timescale" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "color-background-solid" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "WARN":          { "index": 0, "text": "WARN" } } },
            { "type": "value", "options": { "BREAKAGE_RISK": { "index": 1, "text": "BREAKAGE" } } },
            { "type": "value", "options": { "CRITICAL":      { "index": 2, "text": "CRITICAL" } } }
          ]
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 },
      "id": 6,
      "options": { "showHeader": true },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ds-timescale" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.opened_at, a.severity, a.fridge_id, a.site_name, a.duration_sec/60 AS duration_minutes, a.peak_temp_c FROM gold.v_alerts_active a JOIN silver.dim_sites s ON s.site_id = a.site_id WHERE s.country = 'IN' ORDER BY a.opened_at DESC LIMIT 50"
        }
      ],
      "title": "Active alerts",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "ds-timescale" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 50, "lineWidth": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "ds-timescale" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 hour', a.opened_at) AS time, a.severity AS metric, COUNT(*) AS n FROM silver.alerts a JOIN silver.dim_sites s ON s.site_id = a.site_id WHERE s.country = 'IN' AND $__timeFilter(a.opened_at) GROUP BY time, a.severity ORDER BY time"
        }
      ],
      "title": "Alert volume by severity (hourly)",
      "type": "timeseries"
    }
