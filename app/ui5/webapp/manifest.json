{
  "_version": "1.58.0",
  "sap.app": {
    "id": "vaxresilience",
    "type": "application",
    "title": "VaxResilience | Supply Chain Control Tower",
    "applicationVersion": {
      "version": "0.1.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.148.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.tnt": {}
      }
    },
    "rootView": {
      "viewName": "vaxresilience.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "vaxresilience.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true,
        "bypassed": {
          "target": "module"
        }
      },
      "routes": [
        { "pattern": "", "name": "home", "target": "module" },
        { "pattern": "{module}", "name": "module", "target": "module" }
      ],
      "targets": {
        "module": {
          "viewName": "Module",
          "viewLevel": 1
        }
      }
    }
  }
}
